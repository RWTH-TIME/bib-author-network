@article{ WOS:000170488900006,
Author = {Lay, YL},
Title = {Car accident measurement by a scene image},
Journal = {IMAGING SCIENCE JOURNAL},
Year = {2000},
Volume = {48},
Number = {4},
Pages = {199-203},
Abstract = {To record the scene of a car accident, it needs not only the image of
   relative car position but also the relative distance of the accident
   cars. Most range finders can measure the distance but not record the
   image. In this study a digital camera is attached to a portable computer
   to create the platform for a system called the car accident rebuild
   system to record the scene and the distance data. A user only needs to
   click on the two end points of any selected line on the scene image of
   the car accident using the computer `mouse'. By performing this easy
   operation the factual distance between the two points could be measured
   instantly.},
