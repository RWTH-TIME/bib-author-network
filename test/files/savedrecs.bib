Organization = {IEEE; IEIE},
Abstract = {In this paper, we propose a method for car accidenst detection in
   parking lots. The proposed method consists of two steps. In the first
   step, a car is detected by foreground extraction and motion map. In the
   final step, a car accident is detected by the magnitude of motion along
   with moving direction of the car. Experimental results show that
   proposed method effectively detects car accidents in parking lots.},
